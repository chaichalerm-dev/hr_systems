// โครงสร้างข้อมูล HRFlow สำหรับเว็บสาธิต สูตรเงินเดือนและภาษีมีข้อจำกัดตาม README
// HRFlow demo database schema. See README for payroll and tax limitations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ค่าที่อนุญาตให้เลือก เช่น บทบาทและสถานะ
// Allowed values for roles, statuses, and other fixed choices.

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
  HOLIDAY
}

enum LeaveRequestStatus {
  PENDING_MANAGER
  PENDING_HR
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalLevel {
  MANAGER
  HR
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  REVIEWED
  APPROVED
  PAID
}

enum AdjustmentType {
  INCOME
  DEDUCTION
}

// บัญชีผู้ใช้และโครงสร้างองค์กร
// User accounts and organisation structure.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee?

  auditLogs           AuditLog[]        @relation("AuditLogActor")
  leaveApprovals       LeaveApproval[]   @relation("LeaveApprover")
  payrollRunsCreated  PayrollRun[]      @relation("PayrollCreatedBy")
  payrollRunsApproved PayrollRun[]      @relation("PayrollApprovedBy")

  @@index([role])
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions Position[]
  employees Employee[]
}

model Position {
  id           String   @id @default(cuid())
  title        String
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  employees  Employee[]

  @@unique([title, departmentId])
  @@index([departmentId])
}

model Employee {
  id         String @id @default(cuid())
  employeeCode String @unique

  firstName String
  lastName  String
  email     String @unique
  phone     String?

  departmentId String
  positionId   String
  employmentType   EmploymentType   @default(FULL_TIME)
  employmentStatus EmploymentStatus @default(ACTIVE)

  salary    Decimal  @db.Decimal(12, 2)
  startDate DateTime
  endDate   DateTime?

  managerId String?

  profileImageUrl String?

  // ผู้ติดต่อกรณีฉุกเฉิน
  // Emergency contact.
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRelation String?

  // ที่อยู่พนักงาน
  // Employee address.
  addressLine1 String?
  addressLine2 String?
  city         String?
  province     String?
  postalCode   String?
  country      String? @default("Thailand")

  // ข้อมูลธนาคาร ภาษี และประกันสังคมสำหรับสาธิต
  // Bank, tax, and social security details used by the demo.
  bankName          String?
  bankAccountNumber String?
  taxId             String?
  socialSecurityNo  String?

  userId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User?      @relation(fields: [userId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  position   Position   @relation(fields: [positionId], references: [id])
  manager    Employee?  @relation("EmployeeManager", fields: [managerId], references: [id])
  reports    Employee[] @relation("EmployeeManager")

  attendances   Attendance[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  payrollItems  PayrollItem[]

  @@index([departmentId])
  @@index([positionId])
  @@index([managerId])
  @@index([employmentStatus])
}

// บันทึกการลงเวลาเข้า–ออกงาน
// Check-in and check-out records.

model Attendance {
  id         String @id @default(cuid())
  employeeId String

  date      DateTime @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  workingHours Decimal? @db.Decimal(5, 2)
  status    AttendanceStatus @default(PRESENT)

  checkInLatitude   Decimal? @db.Decimal(9, 6)
  checkInLongitude  Decimal? @db.Decimal(9, 6)
  checkInIpAddress  String?
  checkInDevice     String?

  checkOutLatitude  Decimal? @db.Decimal(9, 6)
  checkOutLongitude Decimal? @db.Decimal(9, 6)
  checkOutIpAddress String?
  checkOutDevice    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
}

// ประเภทลา ยอดคงเหลือ คำขอ และผลอนุมัติ
// Leave types, balances, requests, and decisions.

model LeaveType {
  id                 String  @id @default(cuid())
  name               String  @unique
  defaultDaysPerYear Int
  requiresApproval   Boolean @default(true)
  isPaid             Boolean @default(true)

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
}

model LeaveBalance {
  id         String @id @default(cuid())
  employeeId String
  leaveTypeId String
  year       Int

  totalDays     Decimal @db.Decimal(5, 2)
  usedDays      Decimal @default(0) @db.Decimal(5, 2)
  remainingDays Decimal @db.Decimal(5, 2)

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId, year])
}

model LeaveRequest {
  id         String @id @default(cuid())
  employeeId String
  leaveTypeId String

  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  days      Decimal  @db.Decimal(5, 2)
  reason    String

  attachmentUrl  String?
  attachmentName String?

  status LeaveRequestStatus @default(PENDING_MANAGER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee  Employee        @relation(fields: [employeeId], references: [id])
  leaveType LeaveType       @relation(fields: [leaveTypeId], references: [id])
  approvals LeaveApproval[]

  @@index([employeeId])
  @@index([status])
}

model LeaveApproval {
  id             String @id @default(cuid())
  leaveRequestId String
  approverId     String
  level          ApprovalLevel
  decision       ApprovalDecision
  comment        String?
  createdAt      DateTime @default(now())

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id])
  approver     User         @relation("LeaveApprover", fields: [approverId], references: [id])

  @@index([leaveRequestId])
}

// รอบเงินเดือน รายการคำนวณ รายการปรับ และสลิป
// Payroll runs, calculated items, adjustments, and payslips.

model PayrollRun {
  id     String @id @default(cuid())
  month  Int
  year   Int
  status PayrollStatus @default(DRAFT)

  createdById  String
  approvedById String?
  paidAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy  User  @relation("PayrollCreatedBy", fields: [createdById], references: [id])
  approvedBy User? @relation("PayrollApprovedBy", fields: [approvedById], references: [id])

  items PayrollItem[]

  @@unique([month, year])
  @@index([status])
}

model PayrollItem {
  id           String @id @default(cuid())
  payrollRunId String
  employeeId   String

  baseSalary   Decimal @db.Decimal(12, 2)
  overtime     Decimal @default(0) @db.Decimal(12, 2)
  allowance    Decimal @default(0) @db.Decimal(12, 2)
  bonus        Decimal @default(0) @db.Decimal(12, 2)
  commission   Decimal @default(0) @db.Decimal(12, 2)
  otherIncome  Decimal @default(0) @db.Decimal(12, 2)

  unpaidLeaveDeduction Decimal @default(0) @db.Decimal(12, 2)
  absenceDeduction     Decimal @default(0) @db.Decimal(12, 2)
  lateDeduction        Decimal @default(0) @db.Decimal(12, 2)
  socialSecurity       Decimal @default(0) @db.Decimal(12, 2)
  withholdingTax       Decimal @default(0) @db.Decimal(12, 2)
  otherDeductions      Decimal @default(0) @db.Decimal(12, 2)

  grossIncome     Decimal @db.Decimal(12, 2)
  totalDeductions Decimal @db.Decimal(12, 2)
  netSalary       Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollRun  PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee    Employee   @relation(fields: [employeeId], references: [id])
  adjustments PayrollAdjustment[]
  payslip     Payslip?

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model PayrollAdjustment {
  id            String @id @default(cuid())
  payrollItemId String
  type          AdjustmentType
  label         String
  amount        Decimal @db.Decimal(12, 2)
  note          String?
  createdAt     DateTime @default(now())

  payrollItem PayrollItem @relation(fields: [payrollItemId], references: [id])

  @@index([payrollItemId])
}

model Payslip {
  id            String @id @default(cuid())
  payrollItemId String @unique
  issuedAt      DateTime @default(now())

  payrollItem PayrollItem @relation(fields: [payrollItemId], references: [id])
}

// ประวัติการเปลี่ยนแปลงและค่าตั้งบริษัท
// Change history and company settings.

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

model CompanySetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json

  updatedAt DateTime @updatedAt
}
