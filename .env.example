# ที่อยู่ฐานข้อมูล PostgreSQL ของคุณ / Your PostgreSQL connection string.
# แทน user, password และ host ด้วยค่าของฐานข้อมูล / Replace user, password, and host.
DATABASE_URL="postgresql://user:password@host:5432/hrflow?sslmode=require"

# ค่าสุ่มปกป้องเซสชันล็อกอิน ดูวิธีสร้างใน README / Random session secret; see README.
AUTH_SECRET="replace-with-a-random-secret"
# URL ที่ใช้เปิดเว็บ ต้องตรงกับพอร์ตเซิร์ฟเวอร์ / App URL; match the server port.
NEXTAUTH_URL="http://localhost:4200"

# รหัสผ่านบัญชีทดลองที่ seed ใช้ / Passwords used by the demo seed.
# หากเปลี่ยน ให้แก้การ์ดล็อกอินและ e2e/helpers.ts ด้วย / Update login cards and tests too.
DEMO_ADMIN_PASSWORD="Admin@12345"
DEMO_HR_PASSWORD="Hr@12345"
DEMO_MANAGER_PASSWORD="Manager@12345"
DEMO_EMPLOYEE_PASSWORD="Employee@12345"
